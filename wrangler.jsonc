/**
 * cf-activity-relay — Cloudflare Worker configuration.
 *
 * Bindings are documented in the README. Secrets (`ADMIN_TOKEN`, optional
 * `RELAY_PRIVATE_KEY_PEM`) are managed with `wrangler secret put`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-activity-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Smart Placement runs the relay near its D1 primary database. All relay
	 * traffic is server-to-server federation traffic, so this reduces the
	 * latency of the many D1 reads and writes per request.
	 */
	"placement": { "mode": "smart" },
	/**
	 * The canonical identity is the custom domain below. Disable the
	 * `workers.dev` hostname so federation metadata cannot diverge.
	 */
	"workers_dev": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"vars": {
		"RELAY_DOMAIN": "relay.domain.com",
		"RELAY_SERVICENAME": "ActivityPub Relay",
		"RELAY_SUMMARY": "A public ActivityPub relay for the fediverse, running on Cloudflare Workers.",
		"RELAY_ICON": "https://relay.domain.com/logo.png",
		"RELAY_IMAGE": "https://relay.domain.com/banner.png",
		"PUBLIC_ADDRESS_DISTRIBUTION_POLICY": "explicit_public_only",
		"OUTBOUND_SIGNATURE_PROFILE": "dual",
		"PERSON_ONLY": "false",
		"MANUALLY_ACCEPT": "false",
		"MAX_ACTIVITY_BYTES": "1048576",
		"MAX_FANOUT_TARGETS": "5000",
		"MAX_QUEUE_JOBS": "100000"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cf-activity-relay-db",
			"database_id": ""
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": ""
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "DELIVERY_QUEUE",
				"queue": "cf-activity-relay-delivery"
			}
		],
		"consumers": [
			{
				"queue": "cf-activity-relay-delivery",
				"max_batch_size": 25,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"max_concurrency": 10,
				"dead_letter_queue": "cf-activity-relay-delivery-dlq"
			},
			{
				"queue": "cf-activity-relay-delivery-dlq",
				"max_batch_size": 25,
				"max_retries": 0
			}
		]
	},
	"routes": [
		{
			"pattern": "relay.domain.com",
			"custom_domain": true
		}
	],
	"triggers": {
		"crons": ["17 * * * *"]
	}
}
