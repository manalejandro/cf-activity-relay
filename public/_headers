# Security headers for the static assets (landing page and admin dashboard).
# The dashboard and landing page use inline <script>/<style> blocks, so the
# CSP keeps 'unsafe-inline' for script/style but locks everything else down.
/*
	X-Content-Type-Options: nosniff
	Referrer-Policy: no-referrer
	X-Frame-Options: DENY
	Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
/admin/*
	Cache-Control: no-store
